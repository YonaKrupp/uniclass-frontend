{
  "name": "PilotRegistration",
  "type": "object",
  "properties": {
    "fullName": {
      "type": "string",
      "title": "\u05e9\u05dd \u05de\u05dc\u05d0"
    },
    "email": {
      "type": "string",
      "title": "\u05d0\u05d9\u05de\u05d9\u05d9\u05dc"
    },
    "phone": {
      "type": "string",
      "title": "\u05d8\u05dc\u05e4\u05d5\u05df"
    },
    "role": {
      "type": "string",
      "enum": [
        "student",
        "teacher"
      ],
      "default": "student",
      "title": "\u05e1\u05d5\u05d2 \u05de\u05e9\u05ea\u05de\u05e9"
    },
    "institution": {
      "type": "string",
      "title": "\u05de\u05d5\u05e1\u05d3 \u05dc\u05d9\u05de\u05d5\u05d3\u05d9"
    },
    "grade": {
      "type": "string",
      "title": "\u05db\u05d9\u05ea\u05d4 / \u05e9\u05dc\u05d1 (\u05ea\u05dc\u05de\u05d9\u05d3\u05d9\u05dd)"
    },
    "subjects": {
      "type": "string",
      "title": "\u05de\u05e7\u05e6\u05d5\u05e2\u05d5\u05ea"
    },
    "experience": {
      "type": "string",
      "title": "\u05e0\u05d9\u05e1\u05d9\u05d5\u05df (\u05de\u05d5\u05e8\u05d9\u05dd)"
    },
    "notes": {
      "type": "string",
      "title": "\u05d4\u05e2\u05e8\u05d5\u05ea"
    }
  },
  "required": [
    "fullName",
    "email",
    "phone",
    "role"
  ]
}