      "title": "\u05d0\u05d9\u05de\u05d9\u05d9\u05dc \u05ea\u05dc\u05de\u05d9\u05d3"
    },
    "date_of_birth": {
      "type": "string",
      "format": "date",
      "title": "\u05ea\u05d0\u05e8\u05d9\u05da \u05dc\u05d9\u05d3\u05d4"
    },
    "session_id": {
      "type": "string",
      "title": "\u05de\u05d6\u05d4\u05d4 \u05e1\u05e9\u05df \u05d4\u05e8\u05e9\u05de\u05d4"
    },
    "is_verified": {
      "type": "boolean",
      "default": false,
      "title": "\u05d4\u05d4\u05e8\u05e9\u05de\u05d4 \u05d0\u05d5\u05de\u05ea\u05d4"
    }
  },
  "required": [
    "email"
  ],
  "rls": {
